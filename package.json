{
  "name": "bible-bluff",
  "version": "0.1.0",
  "private": true,
  "description": "Bible Bluff – ein Partyspiel für Handys: Bluffs erfinden, die Wahrheit finden, die Bibel entdecken.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "tsx scripts/serve.ts",
    "dev:cf": "wrangler d1 migrations apply bible-bluff --local && wrangler dev",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm test && npm run build",
    "db:migrate:local": "wrangler d1 migrations apply bible-bluff --local",
    "db:migrate:remote": "wrangler d1 migrations apply bible-bluff --remote",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@fontsource/figtree": "^5.3.0",
    "preact": "^10.29.8",
    "qrcode-generator": "^2.0.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3",
    "wrangler": "^4.148.0"
  },
  "engines": {
    "node": ">=20"
  }
}
